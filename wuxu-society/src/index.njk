  <!-- ============ 入社 ============ -->
  <section id="join" class="join">
    <div class="wrap join-in">
      <div>
        <div class="sec-head rv"><h2>邀君入社</h2><hr class="hair" /></div>
        <p class="lead rv">我们常年招收同好。能写的最好，爱读的也欢迎。</p>
        <ul class="rv">
          <li>各地分部定期雅集，线上线下都有；</li>
          <li>新作可入同题合集与社刊编目；</li>
          <li>编委轮流看稿，给具体可改的意见。</li>
        </ul>
      </div>

      <form class="fm rv" id="join-form" novalidate aria-label="入社申请">
        <div class="field">
          <label for="penname">笔名或称呼</label>
          <input id="penname" name="penname" type="text" autocomplete="name" placeholder="例：枕月" required />
        </div>
        <div class="field">
          <label for="mail">邮箱</label>
          <input id="mail" name="mail" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>
        <div class="field">
          <label for="kind">常写的方向</label>
          <select id="kind" name="kind">
            <option value="poem">古诗词</option>
            <option value="modern">现代诗</option>
            <option value="essay">随笔</option>
            <option value="all">都写</option>
            <option value="reader">只读不写</option>
          </select>
        </div>
        <div class="field">
          <label for="note">自我介绍（可选）</label>
          <textarea id="note" name="note" placeholder="三五句即可"></textarea>
        </div>
        <button class="btn" type="submit" style="width:100%">申请入社</button>
        <p class="form-msg" id="form-msg" aria-live="polite"></p>
      </form>
    </div>
  </section>


