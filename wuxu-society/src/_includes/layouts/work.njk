---
layout: "base.njk"
active: "library"
footerNote: "文本录自社内原稿；署名格式为缩写（笔名）。页面由婺需文学社站点构建器依 taste-skill 规范生成。"
---
<main>
<section class="wrap page-head">
<p class="crumb"><a href="index.html">首页</a> / <a href="library.html">作品库</a> / {{ title }}</p>
<h1 class="p-title rv">{{ title }}</h1>
<div class="p-meta rv"><span><b>作者</b> <a href="members.html#{{ ak }}">{{ author }}</a></span><span><b>分部</b> {{ branch }}</span><span><b>体裁</b> {{ genre }}</span>{% if source %}<span><b>出处</b> {{ source }}</span>{% endif %}</div>
</section>
<section class="wrap poem-body rv"><div class="lib-body">
{{ content | safe }}
</div></section>
{% if related %}
<section class="wrap rel rv"><h3>相关联作品</h3>
{% for g in related | relGroups %}
<h4>{{ g.heading }}</h4><ul>
{% for r in g.items %}
<li><span class="t"><a class="plink" href="{{ r.to }}.html">{{ r.title }}</a></span><span class="reason">{{ r.label }}</span></li>
{% endfor %}
</ul>
{% endfor %}
</section>
{% endif %}
</main>
