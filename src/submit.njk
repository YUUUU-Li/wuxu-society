---
layout: "base.njk"
permalink: "submit.html"
title: "作品投稿"
seoTitle: "作品投稿 | 婺需文学社"
desc: "向婺需文学社投稿：填写题名、署名与正文，经编委审阅后发布。"
active: "library"
footerNote: "来稿必经编委审阅，方得入社刊。"
---
<main>
  <section class="wrap page-head">
    <p class="crumb"><a href="index.html">首页</a> / 投稿</p>
    <h1 class="p-title rv">作品投稿</h1>
    <p class="lead rv" style="margin-top:16px">填好下面几项即可投稿。稿子不会立即上线：编委会在预览里通读，通过后发布，有修改意见会退回重投。署名格式：姓名拼音缩写（笔名），如 <code>zk（道格）</code>；暂无笔名写缩写即可。</p>
  </section>

  <section class="wrap">
    <form class="fm rv" id="submit-form" novalidate aria-label="作品投稿">
      <div class="field">
        <label for="sub-title">题名</label>
        <input id="sub-title" name="title" type="text" maxlength="60" placeholder="例：秋望" required />
      </div>
      <div class="field">
        <label for="sub-author">署名</label>
        <input id="sub-author" name="author" type="text" maxlength="40" placeholder="例：zk（道格）" required />
      </div>
      <div class="field">
        <label for="sub-genre">体裁</label>
        <select id="sub-genre" name="genre" required>
          <option value="五绝">五绝</option>
          <option value="七绝">七绝</option>
          <option value="五律">五律</option>
          <option value="七律">七律</option>
          <option value="词">词</option>
          <option value="古风">古风</option>
          <option value="联句">联句</option>
          <option value="现代诗">现代诗</option>
          <option value="散文">散文</option>
          <option value="短篇小说">短篇小说</option>
          <option value="序/记">序/记</option>
          <option value="其他">其他</option>
        </select>
      </div>
      <div class="field">
        <label for="sub-created-year">创作时间（必填）</label>
        <div class="created-row">
          <select id="sub-created-year" aria-label="创作年份" required>
            <option value="">年</option>
            {% for y in yearsList %}<option value="{{ y.v }}">{{ y.label }}</option>{% endfor %}
          </select>
          <select id="sub-created-month" aria-label="创作月份" required>
            <option value="">月</option>
            {% for m in monthsList %}<option value="{{ m.v }}">{{ m.label }}</option>{% endfor %}
          </select>
          <input id="sub-created-day" type="text" inputmode="numeric" maxlength="12" placeholder="日（可选）" aria-label="创作日（可选）" />
        </div>
        <small style="color:var(--dim)">只记得年月就选到月即可；知道具体日子再填"日"。<b>也可以把整串日期直接写进"日"这一格</b>（如 <code>20240911</code>、<code>2024.6.7</code>、<code>2024-6-7</code>、<code>2024年6月7日</code>，只写 <code>2024.6</code> 也行），会自动拆到上面的年、月里。此时间用于作品排序与编委封期，并会显示在作品页的题下信息里。</small>
        <small id="sub-created-note" style="color:var(--seal);display:none"></small>
      </div>
      <div class="field">
        <label for="sub-excerpt">摘句（选填，缩略显示）</label>
        <input id="sub-excerpt" name="excerpt" type="text" maxlength="60" placeholder="例：七百里浙南，长车长驾长归途" />
        <small style="color:var(--dim)">一句话（建议 ≤40 字），将用于首页卡片与列表缩略展示；留空则自动取正文首句。</small>
      </div>
      <div class="field">
        <label for="sub-epigraph">题记（选填）</label>
        <textarea id="sub-epigraph" name="epigraph" rows="2" maxlength="200" placeholder="例：是夜宿江馆，闻雨声不绝，遂录旧句于笺尾。"></textarea>
        <small style="color:var(--dim)">会以<b>楷体</b>排在作品开篇（正文之前），像一句题引或小序；留空则不显示。</small>
      </div>
      <div class="field">
        <label for="sub-selfnote">自注（选填）</label>
        <textarea id="sub-selfnote" name="selfNote" rows="3" maxlength="600" placeholder="例：颔联用《世说新语》王子猷雪夜访戴事；「红砖」指老校区的红砖楼。"></textarea>
        <small style="color:var(--dim)">会以<b>楷体</b>排在作品正文下方（相当于作者自己的注释），与正文隔一条细线；留空则不显示。</small>
      </div>
      <div class="field">
        <label for="sub-note">给编委的附言（选填）</label>
        <textarea id="sub-note" name="editorNote" rows="2" maxlength="500" placeholder="例：此为第三稿，已按上轮意见修改；或：请以笔名发布。"></textarea>
        <small style="color:var(--dim)">仅编委在审稿时可见，不会出现在作品页面上。</small>
      </div>
      <div class="field">
        <label for="sub-imagery">意象（选填，逗号分隔）</label>
        <input id="sub-imagery" name="imageries" type="text" maxlength="200" placeholder="例：秋，雨，思乡归途" />
        <small style="color:var(--dim)">用于自动关联"同意象"作品；不确定可留空。</small>
      </div>
      <div class="field">
        <label for="sub-source">出处 / 雅集（选填）</label>
        <input id="sub-source" name="source" type="text" maxlength="100" placeholder="例：癸卯秋社课" />
      </div>
      <div class="field">
        <div class="sub-head">
          <label for="sub-body">正文</label>
          <button type="button" class="sub-sample" id="sub-sample" title="填入一段包含全部排版功能的示例">示例</button>
        </div>
        <div class="sub-split">
          <textarea id="sub-body" name="body" rows="18" placeholder="诗/词：每行一句，句间自然换行；&#10;散文/小说：自然分段，段与段之间空一行。&#10;行首标记：& 开头 = 楷体文段（前记/后记/序）；> 开头 = 引文块；单独一行 --- = 分割线。&#10;写好后点右侧「预览」看排版效果，或点上方「示例」看范例。" required></textarea>
          <div class="sub-pane">
            <div class="sub-pane-head">
              <span>预览</span>
              <button type="button" class="sub-preview-btn" id="sub-preview-btn">预览</button>
            </div>
            <div class="sub-pane-body lib-body" id="sub-preview">
              <p class="sub-pane-hint">点右上角<b>「预览」</b>，此处按发布的真实版式渲染正文。</p>
            </div>
          </div>
        </div>
        <small style="color:var(--dim)">空行 = 分段。诗词类每行成行；前记/后记等楷体文段，<b>段首加 &amp;</b>（如 <code>&amp;后记：芒种作。</code>）；引文块用 <b>&gt;</b> 开头；单独一行 <b>---</b> 表示分割线。「注：」「评：」开头按赏析块排版。</small>
      </div>
      <p style="position:absolute;left:-9999px" aria-hidden="true">
        <label>网站<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </p>
      <button class="btn" type="submit" style="width:100%" id="sub-btn">提交投稿</button>
      <p class="form-msg" id="sub-msg" aria-live="polite"></p>
    </form>
  </section>
</main>
<script>
(function () {
  "use strict";
  var form = document.getElementById("submit-form");
  var msg = document.getElementById("sub-msg");
  var btn = document.getElementById("sub-btn");
  if (!form) return;

  /* ---------- 创作时间: 也认"整串日期" ---------- */
  // 年/月是下拉, "日"这一格额外接受整串日期(社内习惯写 20240911 / 2024.6.7 / 2024年6月7日),
  // 会自动拆到上面的年、月里; 只认到月的(2024.6 / 202406)也可以 —— 模糊的排在当月具体日子之前。
  var yearEl = document.getElementById("sub-created-year");
  var monthEl = document.getElementById("sub-created-month");
  var dayEl = document.getElementById("sub-created-day");
  var dayNote = document.getElementById("sub-created-note");
  // 先把各种分隔写法统一成 "YYYY-M-D", 再用一条严格正则读(避免 202409 被切成 0 月 9 日这种歧义)
  var RE_DATE = /^(\d{4})-(\d{1,2})(?:-(\d{1,2}))?$/;
  var MDAYS = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];   // 与 scripts/work-order.js 同一张月长表
  function parseLooseDate(v) {
    var s = String(v || "").trim();
    if (!s) return null;
    if (/^\d+$/.test(s)) {
      // 纯数字靠位数判断: 4=年(交给上面的年份下拉, 这里不认) / 6=年月 / 8=年月日
      if (s.length === 6) s = s.slice(0, 4) + "-" + s.slice(4);
      else if (s.length === 8) s = s.slice(0, 4) + "-" + s.slice(4, 6) + "-" + s.slice(6);
      else if (s.length !== 4) return null;
    } else {
      s = s.replace(/\s+/g, "").replace(/[年月.\/]/g, "-").replace(/日$/, "").replace(/-+$/, "");
    }
    var m = RE_DATE.exec(s);
    if (!m) return null;
    var mo = ("0" + m[2]).slice(-2);
    var d = m[3] ? ("0" + m[3]).slice(-2) : "";
    if (+mo < 1 || +mo > 12) return null;
    if (d && (+d < 1 || +d > MDAYS[+mo - 1])) return null;
    return { y: m[1], mo: mo, d: d };
  }
  function hasOption(sel, v) {
    for (var i = 0; i < sel.options.length; i++) if (sel.options[i].value === v) return true;
    return false;
  }
  function showDayNote(t) {
    if (!dayNote) return;
    dayNote.textContent = t || "";
    dayNote.style.display = t ? "block" : "none";
  }
  // 把"日"里的整串日期拆到年、月: 拆成功返回 true
  function absorbLooseDate() {
    if (!dayEl) return false;
    var raw = (dayEl.value || "").trim();
    if (!raw) { showDayNote(""); return false; }
    if (/^\d{1,2}$/.test(raw)) { showDayNote(""); return false; }   // 正常只填"日", 不动
    var p = parseLooseDate(raw);
    if (!p) {
      if (/^\d{4}$/.test(raw)) showDayNote("只知年份的话，" + raw + " 请填在左边的「年」里，月份任选一个相近的即可。");
      else showDayNote("认不出这个日期；可写 20240911、2024.6.7、2024年6月7日，或只写 2024.6。");
      return false;
    }
    if (!hasOption(yearEl, p.y)) { showDayNote("年份 " + p.y + " 不在下拉范围里，请手动选。"); return false; }
    yearEl.value = p.y;
    monthEl.value = p.mo;
    dayEl.value = p.d ? String(+p.d) : "";
    showDayNote("已识别：" + p.y + " 年 " + +p.mo + " 月" + (p.d ? " " + +p.d + " 日" : "（只到月，将排在当月有具体日子的作品之前）"));
    return true;
  }
  if (dayEl) {
    dayEl.addEventListener("input", function () {
      var v = (dayEl.value || "").trim();
      if (v.length >= 8) absorbLooseDate();        // 8 位以上基本是整串, 边打边拆
      else if (!v) showDayNote("");
    });
    dayEl.addEventListener("blur", absorbLooseDate);
    dayEl.addEventListener("change", absorbLooseDate);
  }

  /* ---------- 正文: 示例 + 左写右预览 ---------- */
  var bodyEl = document.getElementById("sub-body");
  var previewEl = document.getElementById("sub-preview");
  var previewBtn = document.getElementById("sub-preview-btn");
  var sampleBtn = document.getElementById("sub-sample");
  var PREVIEW_HINT = '<p class="sub-pane-hint">点右上角<b>「预览」</b>，此处按发布的真实版式渲染正文。</p>';
  // 示例: 覆盖全部排版功能(诗句/空行分段/& 楷体稿/> 引文/--- 分割线/注·评赏析块)
  var SAMPLE = [
    "春水碧于天，画船听雨眠。",
    "垆边人似月，皓腕凝霜雪。",
    "",
    "&前记：丙午年春分后三日，与社中诸子同游婺江，归而作此。",
    "",
    "舟行三十里，忽见江心孤屿，上有旧亭三间，苔痕满地。同行者曰：“此亭废已廿年。”",
    "",
    "> 昔我往矣，杨柳依依。",
    "> 今我来思，雨雪霏霏。",
    "",
    "---",
    "",
    "&后记：是夜宿江馆，闻雨声不绝，遂录旧句于笺尾。",
    "",
    "注：上阕写景，下阕写人，两结皆以景收。",
    "",
    "评（hde）：丽而不腻，尾句尤有余味。",
  ].join("\n");

  var paneEl = document.querySelector(".sub-pane");
  // 两栏高度同步: 以内容较长者为准(手机上堆叠时不处理)
  function syncHeights() {
    if (window.innerWidth <= 820) { bodyEl.style.height = ""; if (paneEl) paneEl.style.height = ""; return; }
    bodyEl.style.height = "auto";
    var need = Math.max(bodyEl.scrollHeight, previewEl.scrollHeight + 40, 420);
    bodyEl.style.height = need + "px";
    if (paneEl) paneEl.style.height = need + "px";
  }

  function renderPreview() {
    var body = bodyEl.value.trim();
    if (!body) { previewEl.innerHTML = PREVIEW_HINT; syncHeights(); return; }
    previewBtn.disabled = true;
    previewEl.innerHTML = '<p class="sub-pane-hint">正在排版…</p>';
    fetch("{{ site.apiBase | default('/api') }}/preview", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        body: body,
        genre: form.genre.value,
        epigraph: form.epigraph.value.trim(),
        selfNote: form.selfNote.value.trim()
      }),
    })
      .then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (j) {
        previewEl.innerHTML = j && j.ok
          ? j.html
          : '<p class="sub-pane-hint">' + ((j && j.error) || "预览失败，请稍后再试。") + "</p>";
      })
      .catch(function () {
        previewEl.innerHTML = '<p class="sub-pane-hint">网络不通，预览失败；投稿不受影响。</p>';
      })
      .then(function () { previewBtn.disabled = false; syncHeights(); });
  }
  if (previewBtn) previewBtn.addEventListener("click", renderPreview);
  if (sampleBtn) sampleBtn.addEventListener("click", function () {
    if (bodyEl.value.trim() && !window.confirm("将用示例替换现有正文，继续？")) return;
    bodyEl.value = SAMPLE;
    bodyEl.focus();
    renderPreview();
  });
  // 手动编辑时也保持两栏等高(防抖)
  var syncT = null;
  bodyEl.addEventListener("input", function () {
    if (syncT) clearTimeout(syncT);
    syncT = setTimeout(syncHeights, 400);
  });
  // 题记/自注改了也要重新预览(它们直接进开篇与正文下方)
  var previewT = null;
  [form.epigraph, form.selfNote].forEach(function (el) {
    if (!el) return;
    el.addEventListener("input", function () {
      if (!bodyEl.value.trim()) return;
      if (previewT) clearTimeout(previewT);
      previewT = setTimeout(renderPreview, 800);
    });
  });
  window.addEventListener("resize", syncHeights);
  form.addEventListener("submit", function (ev) {
    ev.preventDefault();
    msg.className = "form-msg";
    var title = form.title.value.trim();
    var author = form.author.value.trim();
    var genre = form.genre.value;
    var body = form.body.value.trim();
    if (!title) { msg.textContent = "请先写题名。"; msg.className = "form-msg err"; form.title.focus(); return; }
    if (!author) { msg.textContent = "请留下署名（缩写或缩写（笔名））。"; msg.className = "form-msg err"; form.author.focus(); return; }
    if (body.length < 10) { msg.textContent = "正文太短了，再写几句吧。"; msg.className = "form-msg err"; form.body.focus(); return; }
    // 先把"日"里的整串日期拆开(用户可能只填了那一格就点提交)
    absorbLooseDate();
    var createdYear = yearEl.value;
    var createdMonth = monthEl.value;
    if (!createdYear || !createdMonth) {
      msg.textContent = "请选择创作时间（年、月）；也可以把整串日期写进「日」（如 20240911）。";
      msg.className = "form-msg err"; yearEl.focus(); return;
    }
    var dayRaw = (dayEl.value || "").trim();
    var day = "";
    var loose = parseLooseDate(dayRaw);
    if (loose) {
      // 用户把整串日期填进了"日": 就用整串(顺手把上面的年、月也同步过去)
      if (!hasOption(yearEl, loose.y)) {
        msg.textContent = "年份 " + loose.y + " 超出可选范围（" + yearEl.options[yearEl.options.length - 1].value + "–" + yearEl.options[1].value + "），请手动选。";
        msg.className = "form-msg err"; yearEl.focus(); return;
      }
      yearEl.value = loose.y;
      monthEl.value = loose.mo;
      day = loose.d;
      createdYear = loose.y;
      createdMonth = loose.mo;
      dayEl.value = loose.d ? String(+loose.d) : "";
    } else if (dayRaw) {
      if (!/^\d{1,2}$/.test(dayRaw) || +dayRaw < 1 || +dayRaw > 31) {
        msg.textContent = "「日」请填 1–31（不填也行），或把整串日期写进来（如 20240911、2024.6.7）。";
        msg.className = "form-msg err"; dayEl.focus(); return;
      }
      day = ("0" + dayRaw).slice(-2);
    }
    var created = createdYear + "-" + createdMonth + (day ? "-" + day : "");
    var payload = {
      title: title,
      author: author,
      genre: genre,
      created: created,
      body: body,
      excerpt: form.excerpt.value.trim(),
      epigraph: form.epigraph.value.trim(),
      selfNote: form.selfNote.value.trim(),
      editorNote: form.editorNote.value.trim(),
      imageries: form.imageries.value,
      source: form.source.value,
      website: form.website.value
    };
    btn.disabled = true;
    btn.textContent = "正在提交…";
    msg.textContent = "正在把稿件送进审稿队列，请稍候…";
    fetch("{{ site.apiEndpoint | default('/api/submit') }}", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (res.ok && res.j.ok) {
          msg.className = "form-msg";
          msg.innerHTML = "投稿成功，已进入审稿队列" + (res.j.number ? "（编号 #" + res.j.number + "）" : "") +
            "。编委通过后会自动发布；若需修改，可在同一条投稿里留言重投。<br />" +
            (res.j.html_url ? '<a href="' + res.j.html_url + '" target="_blank" rel="noopener">查看审稿单（需 GitHub 登录）</a>' : "");
          form.reset();
          showDayNote("");
        } else {
          msg.textContent = res.j && res.j.error ? res.j.error : "提交失败，请稍后再试或联系社长。";
          msg.className = "form-msg err";
        }
      })
      .catch(function () {
        msg.textContent = "网络异常，提交失败。请稍后重试，或把稿件发给社长代投。";
        msg.className = "form-msg err";
      })
      .finally(function () {
        btn.disabled = false;
        btn.textContent = "提交投稿";
      });
  });
})();
</script>
