  <!-- ============ 随机拾读 ============ -->
  <section id="picks">
    <div class="wrap">
      <div class="sec-head rv"><h2>随机拾读</h2><hr class="hair" /></div>
      <p class="lead rv">满库诗笺，每次打开换四篇——不期而遇，亦算缘分。点篇名读全文与关联作品。</p>
      {% set homePool = collections.works | homeCards %}
      <div class="poem-grid" id="home-picks">
        {% for c in homePool.slice(0, 4) %}
        <article class="poem-item">
          <h3 class="pi-title"><a class="plink" href="{{ c.href }}">{{ c.title }}</a></h3>
          <p class="pi-meta"><span>{{ c.name }}</span><span>{{ c.genre }}</span></p>
          <p class="pi-line">“{{ c.line }}”</p>
          <a class="pi-link" href="{{ c.href }}">读全文与关联作品</a>
        </article>
        {% endfor %}
      </div>
      <script type="application/json" id="home-pool">{{ homePool | toJSON | safe }}</script>
      <script>
      (function () {
        "use strict";
        var grid = document.getElementById("home-picks");
        var dataEl = document.getElementById("home-pool");
        if (!grid || !dataEl) return;
        var pool;
        try { pool = JSON.parse(dataEl.textContent); } catch (e) { return; }
        function build(c) {
          var a = document.createElement("article");
          a.className = "poem-item";
          var h = document.createElement("h3"); h.className = "pi-title";
          var l = document.createElement("a"); l.className = "plink"; l.href = c.href; l.textContent = c.title;
          h.appendChild(l);
          var meta = document.createElement("p"); meta.className = "pi-meta";
          var s1 = document.createElement("span"); s1.textContent = c.name;
          var s2 = document.createElement("span"); s2.textContent = c.genre;
          meta.appendChild(s1); meta.appendChild(s2);
          var line = document.createElement("p"); line.className = "pi-line";
          line.textContent = "“" + c.line + "”";
          var more = document.createElement("a"); more.className = "pi-link"; more.href = c.href;
          more.textContent = "读全文与关联作品";
          a.appendChild(h); a.appendChild(meta); a.appendChild(line); a.appendChild(more);
          return a;
        }
        function render() {
          var arr = pool.slice();
          for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
          }
          var frag = document.createDocumentFragment();
          for (var k = 0; k < 4 && k < arr.length; k++) frag.appendChild(build(arr[k]));
          grid.innerHTML = "";
          grid.appendChild(frag);
        }
        render();
      })();
      </script>
    </div>
  </section>

  <!-- ============ 入社 ============ -->
  <section id="join" class="join">
    <div class="wrap join-in">
      <div>
        <div class="sec-head rv"><h2>邀君入社</h2><hr class="hair" /></div>
        <p class="lead rv">我们常年招收同好。能写的最好，爱读的也欢迎。</p>
        <ul class="rv">
          <li>各地分部定期雅集，线上线下都有；</li>
          <li>新作可入同题合集与社刊编目；</li>
          <li>编委轮流看稿，给具体可改的意见。</li>
        </ul>
      </div>

      <form class="fm rv" id="join-form" novalidate aria-label="入社申请">
        <div class="field">
          <label for="penname">笔名或称呼</label>
          <input id="penname" name="penname" type="text" autocomplete="name" placeholder="例：枕月" required />
        </div>
        <div class="field">
          <label for="mail">邮箱</label>
          <input id="mail" name="mail" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>
        <div class="field">
          <label for="kind">常写的方向</label>
          <select id="kind" name="kind">
            <option value="poem">古诗词</option>
            <option value="modern">现代诗</option>
            <option value="essay">随笔</option>
            <option value="all">都写</option>
            <option value="reader">只读不写</option>
          </select>
        </div>
        <div class="field">
          <label for="note">自我介绍（可选）</label>
          <textarea id="note" name="note" placeholder="三五句即可"></textarea>
        </div>
        <button class="btn" type="submit" style="width:100%">申请入社</button>
        <p class="form-msg" id="form-msg" aria-live="polite"></p>
      </form>
    </div>
  </section>

