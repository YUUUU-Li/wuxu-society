{# 一行作品: 已填/未填创作时间共用同一套 DOM(未填者带 data-undated 供筛选后收合小节标题) #}
{% macro libRow(w, undated) %}<div class="idx-row rv" data-author="{{ w.data.author }}" data-genre="{{ w.data.genre }}" data-imagery="{{ w.data.imageries | default([]) | join('|') }}" data-source="{{ w.data.source | default('') }}"{% if undated %} data-undated="1"{% endif %}><span><a class="plink" href="{{ w.url }}">{{ w.data.title }}</a></span><span class="g">{{ w.data.author }}</span><span class="f">{{ w.data.genre }}</span></div>{% endmacro %}
<main>
  <section class="wrap page-head">
    <p class="crumb"><a href="index.html">首页</a> / 作品库</p>
    <h1 class="p-title rv">作品库</h1>
    <p class="lead rv" style="margin-top:16px">社内文稿总目，按创作时间先后排列（早者在前）；尚未考订创作时间的篇目另列于后一节的「年份待考」。上方可依作者、体裁、意象、出处筛选；点击篇名进入单篇，页内可读全文与相关联作品。雅集与刊期编目见<a class="plink" href="yaji.html">雅集</a>。</p>
  </section>

  <section class="wrap lib-filters">
    <div class="filters rv" role="search" aria-label="筛选作品">
      <select id="f-author" aria-label="按作者筛选"><option value="">全部作者</option></select>
      <select id="f-genre" aria-label="按体裁筛选"><option value="">全部体裁</option></select>
      <select id="f-imagery" aria-label="按意象筛选"><option value="">全部意象</option></select>
      <select id="f-source" aria-label="按出处筛选"><option value="">全部出处</option></select>
      <button type="button" class="f-reset" id="f-reset" hidden>清除筛选</button>
      <span class="f-count" id="f-count"></span>
    </div>
  </section>

{% set wm = collections.works | worksMap %}
  <section class="wrap">
    <div class="idx-list" id="lib-list">
      {% for slug in fulltextSorted %}{% set w = wm[slug] %}{% if w and w.data.created %}{{ libRow(w, false) }}{% endif %}{% endfor %}
      {% if undatedSlugs | length %}
      <div class="sec-head rv idx-undated" id="lib-undated-head"><h3>年份待考</h3><span class="cnt">共 {{ undatedSlugs | length }} 篇尚未考订创作时间，暂列于后</span><hr class="hair" /></div>
      {% for slug in undatedSlugs %}{% set w = wm[slug] %}{% if w %}{{ libRow(w, true) }}{% endif %}{% endfor %}
      {% endif %}
    </div>
    <p class="idx-empty" id="lib-empty" hidden>没有符合条件的作品。</p>
  </section>

  <script type="application/json" id="lib-pool">[
{% for slug in fulltextSorted %}{% set w = wm[slug] %}{% if w %}
{"t":{{ w.data.title | jsonify | safe }},"a":{{ w.data.author | jsonify | safe }},"g":{{ w.data.genre | jsonify | safe }},"i":{{ w.data.imageries | jsonarr | safe }},"s":{{ (w.data.source or "") | jsonify | safe }},"h":{{ w.url | jsonify | safe }}}{% if not loop.last %},{% endif %}{% endif %}
{% endfor %}]
  </script>
<script>
(function () {
  "use strict";
  var author = document.getElementById("f-author");
  var genre = document.getElementById("f-genre");
  var imagery = document.getElementById("f-imagery");
  var source = document.getElementById("f-source");
  var reset = document.getElementById("f-reset");
  var count = document.getElementById("f-count");
  var poolEl = document.getElementById("lib-pool");
  var list = document.getElementById("lib-list");
  var empty = document.getElementById("lib-empty");
  var undatedHead = document.getElementById("lib-undated-head");
  if (!author || !poolEl || !list) return;
  var pool = JSON.parse(poolEl.textContent);      // 全站作品(含入期), 已按创作时间排序
  var rows = Array.prototype.slice.call(list.querySelectorAll(".idx-row"));
  var total = rows.length;

  function fill(sel, values) {
    values.forEach(function (v) {
      var o = document.createElement("option");
      o.value = v; o.textContent = v;
      sel.appendChild(o);
    });
  }
  var authors = {}, genres = {}, imags = {}, sources = {};
  pool.forEach(function (w) {
    authors[w.a] = 1;
    genres[w.g] = 1;
    sources[w.s || "(无出处)"] = 1;
    (w.i || []).forEach(function (x) { imags[x] = 1; });
  });
  fill(author, Object.keys(authors).sort(function (a, b) { return a.localeCompare(b, "zh"); }));
  fill(genre, Object.keys(genres));
  fill(imagery, Object.keys(imags).sort(function (a, b) { return a.localeCompare(b, "zh"); }));
  fill(source, Object.keys(sources));

  // 筛选状态存在 URL 里(如 library.html?author=jwl&genre=七言古风): 既可分享, 也是"返回本页"时的唯一真相
  var KEYS = ["author", "genre", "imagery", "source"];
  var bind = { author: author, genre: genre, imagery: imagery, source: source };

  // 值对不上时再试"唯一前缀": 手写 ?author=jwl 也能落到「jwl（蓦流）」; 前缀撞车(有歧义)就当没写
  function matchLoose(sel, v) {
    var hit = "";
    for (var i = 0; i < sel.options.length; i++) {
      var o = sel.options[i].value;
      if (!o || o.indexOf(v) !== 0) continue;
      if (hit) return "";
      hit = o;
    }
    return hit;
  }

  function readURL() {
    var qs = new URLSearchParams(location.search);
    KEYS.forEach(function (k) {
      var v = qs.get(k) || (k === "genre" ? qs.get("category") : null);   // category 为兼容别名
      bind[k].value = v || "";                                            // 认不出的值落回"全部"(下拉框会自己回正)
      if (v && !bind[k].value) bind[k].value = matchLoose(bind[k], v);
    });
  }

  function writeURL() {
    var qs = new URLSearchParams();
    KEYS.forEach(function (k) { if (bind[k].value) qs.set(k, bind[k].value); });   // 固定顺序, 链接清爽
    new URLSearchParams(location.search).forEach(function (v, k) {
      if (KEYS.indexOf(k) === -1 && k !== "category") qs.append(k, v);            // 其余参数(如 utm_*)原样保留
    });
    var q = qs.toString();
    try {
      history.replaceState(history.state, "", location.pathname + (q ? "?" + q : "") + location.hash);
    } catch (e) {
      // 双击 dist/library.html 直接以 file:// 打开时, 浏览器不许脚本改地址栏(origin 为 null)会抛错;
      // 那种情况下筛选照常生效, 只是地址栏不同步 —— 要验 URL 得走 http(见《编委操作手册》§1)。
    }
  }

  function apply() {
    var fa = author.value, fg = genre.value, fi = imagery.value, fs = source.value;
    var any = fa || fg || fi || fs;
    var shown = 0, shownUndated = 0;
    rows.forEach(function (row) {
      var ok = (!fa || row.dataset.author === fa) &&
        (!fg || row.dataset.genre === fg) &&
        (!fi || (row.dataset.imagery || "").split("|").indexOf(fi) !== -1) &&
        (!fs || (row.dataset.source || "(无出处)") === fs);
      row.style.display = ok ? "" : "none";
      if (ok) { shown++; if (row.dataset.undated) shownUndated++; }
    });
    if (undatedHead) undatedHead.hidden = shownUndated === 0;   // 该节全被筛掉时连标题一起收
    if (count) count.textContent = "显示 " + shown + " / " + total + " 篇";
    if (reset) reset.hidden = !any;
    if (empty) empty.hidden = shown !== 0;
    writeURL();          // 每次筛选都写回地址栏(用 replaceState, 不往历史里堆条目)
  }
  [author, genre, imagery, source].forEach(function (s) {
    s.addEventListener("change", apply);
  });
  if (reset) reset.addEventListener("click", function () {
    [author, genre, imagery, source].forEach(function (s) { s.value = ""; });
    apply();
  });
  // 后退/前进回到本页时, 浏览器会自己还原下拉框的值, 却不会重算列表(也不触发 change),
  // 于是出现"看着筛过了、内容却是全量"的对不上 —— 一律以 URL 为准重新对齐
  window.addEventListener("pageshow", function () { readURL(); apply(); });
  readURL();       // 进场先按 URL 预选(下拉框的选项此时已填好, 必须在 fill() 之后)
  apply();
})();
</script>
</main>
