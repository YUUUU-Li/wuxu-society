{% set ak = author | akOf %}
{% set branch = author | branchOf %}
{% set active = "library" %}
{% set seoTitle = title ~ " | 婺需文学社" %}
{% set desc = author ~ "《" ~ title ~ "》全文与相关联作品。" %}
{% set footerNote = "文本录自社内原稿，署名用缩写（笔名）。" %}
<!doctype html>
<html lang="zh-CN">
<head>
{% include "partials/head.njk" %}
</head>
<body>
{% include "partials/nav.njk" %}
<main>
<section class="wrap page-head">
<p class="crumb"><a href="index.html">首页</a> / <a href="library.html">作品库</a> / {{ title }}</p>
<h1 class="p-title rv">{{ title }}</h1>
<div class="p-meta rv"><span><b>作者</b> <a href="members.html#{{ ak }}">{{ author }}</a></span><span><b>分部</b> {{ branch }}</span><span><b>体裁</b> {{ genre }}</span>{% if created %}<span><b>创作时间</b> {{ created | cnDate }}</span>{% endif %}{% if source %}<span><b>出处</b> {{ source }}</span>{% endif %}</div>
</section>
{% set workCpts = concepts | conceptsOf(page.fileSlug, issues) %}
{% if workCpts.length %}
<p class="work-concepts rv">本期概念：{% for c in workCpts %}<a class="chip" href="concepts/{{ c.id }}.html">{{ c.name }}</a>{% endfor %}</p>
{% endif %}
<section class="wrap poem-body rv"><div class="lib-body">
{# 题记: 投稿时填的「题记」统一排在正文开篇, 楷体(与 preview.js 的包法一致) #}
{% if epigraph %}<p class="work-epigraph kaiti">{{ epigraph | escLines | safe }}</p>{% endif %}
{{ content | safe }}
{# 自注: 投稿时填的「自注」统一排在正文下方, 楷体, 与正文隔一条细线 #}
{% if selfNote %}<div class="work-selfnote kaiti">{{ selfNote | escLines | safe }}</div>{% endif %}
</div></section>
{% include "partials/zhuzhu.njk" %}
{% set relGroups = { slug: page.fileSlug, author: author, imageries: imageries, source: source, related: related } | relOf(collections.works) %}
{% if relGroups.length %}
<section class="wrap rel rv"><h3>相关联作品</h3>
{% for g in relGroups %}
{% if g.kind === "similar" %}
{% if site.zhuzhu and site.zhuzhu.enabled %}<div class="rel-sim" id="rel-sim" data-work="{{ page.fileSlug }}" hidden></div>{% endif %}
{% else %}
{% if g.rotateMax and g.items.length > g.rotateMax %}
<h4 class="rel-h4">{{ g.heading }}<span class="cnt">共 {{ g.items.length }} 篇 · 每次打开随机呈现</span><button class="shuffle" type="button" hidden>换一批 ↻</button></h4>
<ul class="rel-ul" data-rotate="{{ g.rotateMax }}">
{% for r in g.items %}{% if loop.index <= g.rotateMax %}<li><span class="t"><a class="plink" href="{{ r.to }}.html">{{ r.title }}</a></span><span class="reason">{{ r.label }}</span></li>{% endif %}{% endfor %}
</ul>
<template class="rel-pool">
{% for r in g.items %}<li><span class="t"><a class="plink" href="{{ r.to }}.html">{{ r.title }}</a></span><span class="reason">{{ r.label }}</span></li>{% endfor %}
</template>
{% else %}
<h4>{{ g.heading }}{% if g.items.length > 1 %}<span class="cnt">共 {{ g.items.length }} 篇</span>{% endif %}</h4>
<ul>
{% for r in g.items %}<li><span class="t"><a class="plink" href="{{ r.to }}.html">{{ r.title }}</a></span><span class="reason">{{ r.label }}</span></li>{% endfor %}
</ul>
{% endif %}
{% endif %}
{% endfor %}
</section>
{% endif %}
</main>
{% include "partials/footer.njk" %}
<script src="site.js?v={{ assetVer }}"></script>
</body>
</html>
