<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% if seoTitle %}{{ seoTitle }}{% else %}{{ site.name }} | {{ site.slogan }}{% endif %}</title>
<meta name="description" content="{{ desc | default(site.slogan) }}" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="site.css" />
<link rel="icon" type="image/png" href="favicon.png" />
<link rel="apple-touch-icon" href="apple-touch-icon.png" />
<script>document.documentElement.classList.add("js");</script>
