<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% if seoTitle %}{{ seoTitle }}{% else %}{{ site.name }} | {{ site.slogan }}{% endif %}</title>
<meta name="description" content="{{ desc | default(site.slogan) }}" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{% if seoTitle %}{{ seoTitle }}{% else %}{{ title | default(site.name) }}{% endif %}" />
<meta property="og:description" content="{{ desc | default(site.slogan) }}" />
<meta property="og:image" content="{{ site.url }}/hero-qingming.jpg" />
<meta property="og:url" content="{{ site.url }}{{ page.url }}" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="site.css" />
<link rel="icon" type="image/png" href="favicon.png" />
<link rel="apple-touch-icon" href="apple-touch-icon.png" />
<script>(function(){try{var t=localStorage.getItem("theme");if(t!=="dark"&&t!=="light"){t=window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";}document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","light");}})();</script>
<script>document.documentElement.classList.add("js");</script>
