<header>
  <div class="wrap nav">
    <a class="brand" href="index.html"><img class="brand-logo" src="logo.png" alt="{{ site.name }}" width="1508" height="296" /></a>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="切换深浅色" aria-pressed="false" title="切换深浅色">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/></svg>
    </button>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-label="菜单" aria-expanded="false">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
    <nav class="nav-links" aria-label="主导航">
      <a class="txt" href="{% if home %}#origin{% else %}index.html#origin{% endif %}">缘起</a>
      <a class="txt{% if active == 'yaji' %} on{% endif %}" href="yaji.html">雅集</a>
      <a class="txt{% if active == 'members' %} on{% endif %}" href="members.html">社员</a>
      <a class="txt{% if active == 'library' %} on{% endif %}" href="library.html">作品库</a>
      <a class="txt" href="{% if home %}#join{% else %}index.html#join{% endif %}">申请入社</a>
      <a class="txt" href="submit.html">投稿</a>
      <label class="palette-pick" title="配色主题">
        <span class="visually-hidden">配色主题</span>
        <select id="palette-select" class="palette-select">
          <option value="celadon">青瓷</option>
          <option value="vermilion">朱墨</option>
          <option value="pine">松烟</option>
          <option value="lotus">藕荷</option>
          <option value="deco">海派</option>
        </select>
      </label>
      {# 账号态(登录/注册 · 笔名 · 退出): 由 auth.js 填, 未登录时是个和页头按钮同款的入口 #}
      <span class="nav-auth" id="nav-auth" hidden></span>
    </nav>
  </div>
</header>
{# 账号态(登录/注册 · 笔名 · 退出)与弹窗: 全站脚本, 放在导航里保证每个页面都有入口 #}
<script src="auth.js?v={{ assetVer }}"></script>
