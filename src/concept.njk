---
layout: "base.njk"
title: "概念"
seoTitle: "概念 | 婺需文学社"
desc: "婺需文学社概念档案：跨期的主题与共识。"
active: "library"
footerNote: "概念档案，题解由社里共叙后补。"
pagination:
  data: concepts
  size: 1
  alias: cpt
permalink: "concepts/{{ cpt.id }}.html"
eleventyExcludeFromCollections: true
---
<main>
  <section class="wrap page-head">
    <p class="crumb"><a href="index.html">首页</a> / <a href="library.html">作品库</a> / <a href="library.html">刊期档案</a> / 概念</p>
    <h1 class="p-title rv">{{ cpt.name }}</h1>
    {% if cpt.note %}<p class="lead rv concept-note" style="margin-top:10px">{{ cpt.note }}</p>{% endif %}
  </section>

{% set wm = collections.works | worksMap %}
{% set slugs = issues | conceptSlugs(cpt.id) %}
  <section class="wrap idx-group">
    <div class="sec-head rv"><h2>收录篇目</h2><hr class="hair" /></div>
    <div class="idx-list">
    {% for slug in slugs %}{% set w = wm[slug] %}{% if w %}
      <div class="idx-row rv"><span><a class="plink" href="{{ w.url }}">{{ w.data.title }}</a></span><span class="g">{{ w.data.author }}</span><span class="f">{{ w.data.genre }}</span></div>
    {% endif %}{% endfor %}
    </div>
  </section>

  {% if cpt.related and cpt.related.length %}
  <section class="wrap issue-concepts">
    <p class="concept-line rv">相近概念：{% for rid in cpt.related %}{% set rc = concepts | findConcept(rid) %}{% if rc %}<a class="chip" href="concepts/{{ rc.id }}.html">{{ rc.name }}</a>{% endif %}{% endfor %}</p>
  </section>
  {% endif %}
</main>
